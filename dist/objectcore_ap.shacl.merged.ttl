        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The period during which an event took place (CRM P4 has time-span)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:temporal ],
        [ sh:class oc:ObjectLocation ;
            sh:description "The place where an event happened (CRM P7 took place at). Not the spatial coverage of a dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:atLocation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The kind of hazard found in a hazard assessment." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:hazardType ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:used ],
        [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:source ],
        [ sh:description "The conclusion of a provenance research event." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path oc:finding ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oc:uncertainty ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:generated ],
        [ sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 10 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "A protective measure taken against a hazard." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:protectiveMeasure ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class <http://qudt.org/schema/qudt/Quantity> ] [ sh:class prov:Entity ] ) ;
            sh:path dcterms:relation ],
        [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path prov:qualifiedAssociation ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dcterms:isPartOf ] ;
    sh:targetClass oc:HazardAssessmentEvent .

oc:MonitoringEvent a sh:NodeShape ;
    rdfs:comment "Monitoring of conditions around an object, with measured values (KuR-MDS 4.8). Values go into has_quantitative_attribute." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class <http://qudt.org/schema/qudt/Quantity> ] ) ;
            sh:path dcterms:relation ],
        [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:source ],
        [ sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "A condition that is checked in a monitoring event (for example humidity)." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:monitoredCondition ],
        [ sh:description "The conclusion of a provenance research event." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path oc:finding ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:isPartOf ],
        [ sh:class oc:ObjectLocation ;
            sh:description "The place where an event happened (CRM P7 took place at). Not the spatial coverage of a dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path prov:atLocation ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:generated ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class schema1:DefinedTerm ] ) ;
            sh:path dcterms:type ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oc:uncertainty ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:used ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The period during which an event took place (CRM P4 has time-span)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:temporal ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:wasInformedBy ],
        [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:qualifiedAssociation ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ] ;
    sh:targetClass oc:MonitoringEvent .

oc:ObjectCoreDataset a sh:NodeShape ;
    rdfs:comment "A dcat:Dataset (DCAT-AP 3.0.1) that describes an object, a sample or events of an object biography. Adds the mandatory elements of the NFDI Core Metadata Profile (identifier, title, creator, resource type, licence via the distribution) on top of DCAT-AP." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dcterms:Frequency ;
            sh:description "The frequency at which the Dataset is updated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dcterms:accrualPeriodicity ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A secondary identifier of the Dataset" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
            sh:description "The legislation that mandates the creation or management of the Dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://data.europa.eu/r5r/applicableLegislation> ],
        [ sh:class skos:Concept ;
            sh:description "A type of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path dcterms:type ],
        [ sh:class dcterms:RightsStatement ;
            sh:description "Information that indicates whether the Dataset is publicly accessible, has access restrictions or is not public." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:accessRights ],
        [ sh:class dcterms:LinguisticSystem ;
            sh:description "A language of the Dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcterms:language ],
        [ sh:class dcterms:Location ;
            sh:description "A geographic region that is covered by the Dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:spatial ],
        [ sh:description "The main identifier for the Dataset, e.g. the URI or other unique identifier in the context of the Catalogue." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 12 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:description "Name of the system from which the record was exported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path oc:sourceSystem ],
        [ sh:class dcterms:Standard ;
            sh:description "An implementing rule or other specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:conformsTo ],
        [ sh:class dcat:Distribution ;
            sh:description "A sample distribution of the dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path <http://www.w3.org/ns/adms#sample> ],
        [ sh:class rdfs:Resource ;
            sh:description "A related resource." ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dcterms:relation ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "A temporal period that the Dataset covers." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path dcterms:temporal ],
        [ sh:class rdfs:Resource ;
            sh:description "A related resource, such as a publication, that references, cites, or otherwise points to the dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:isReferencedBy ],
        [ sh:class dcterms:ProvenanceStatement ;
            sh:description "A statement about the lineage of a Dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path dcterms:provenance ],
        [ sh:class <http://www.w3.org/2006/vcard/ns#Kind> ;
            sh:description "Contact information that can be used for sending comments about the Dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcat:contactPoint ],
        [ sh:class foaf:Document ;
            sh:description "A web page that provides access to the Dataset, its Distributions and/or additional information." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcat:landingPage ],
        [ sh:class dcat:DatasetSeries ;
            sh:description "A dataset series of which the dataset is part." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path dcat:inSeries ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 37 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset from which the described Dataset is derived." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dcterms:source ],
        [ sh:description "A free-text account of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:description "The version indicator (name or identifier) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 34 ;
            sh:path dcat:version ],
        [ sh:description "A name given to the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 32 ;
            sh:path dcterms:title ],
        [ sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] ) ;
            sh:path dcterms:subject ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:class foaf:Document ;
            sh:description "A page or document about this Dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path foaf:page ],
        [ sh:class foaf:Agent ;
            sh:description "An entity responsible for producing the dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:creator ],
        [ sh:description "A description of the differences between this version and a previous version of the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 35 ;
            sh:path <http://www.w3.org/ns/adms#versionNotes> ],
        [ sh:description "A keyword or tag describing the Dataset." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 15 ;
            sh:path dcat:keyword ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Dataset was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:modified ],
        [ sh:class dcat:Relationship ;
            sh:description "A description of a relationship with another resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path dcat:qualifiedRelation ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:issued ],
        [ sh:class skos:Concept ;
            sh:description "A category of the Dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path dcat:theme ],
        [ sh:class oc:ObjectCoreDistribution ;
            sh:description "An available Distribution for the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcat:distribution ],
        [ sh:class dcat:Dataset ;
            sh:description "A related Dataset that is a version, edition, or adaptation of the described Dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcat:hasVersion ],
        [ sh:class prov:Attribution ;
            sh:description "An Agent having some form of responsibility for the resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path prov:qualifiedAttribution ],
        [ sh:class prov:Activity ;
            sh:description "An activity that generated, or provides the business context for, the creation of the dataset." ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class foaf:Agent ;
            sh:description "An entity (organisation) responsible for making the Dataset available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path dcterms:publisher ] ;
    sh:targetClass oc:ObjectCoreDataset .

oc:ObjectEventMixin a sh:NodeShape ;
    rdfs:comment "Slots shared by all events of an object biography." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:source ],
        [ sh:class oc:ObjectLocation ;
            sh:description "The place where an event happened (CRM P7 took place at). Not the spatial coverage of a dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path prov:atLocation ],
        [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path prov:qualifiedAssociation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Refines the kind of event with a term from a controlled vocabulary (for example translocation for a move)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dcterms:type ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The period during which an event took place (CRM P4 has time-span)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:temporal ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oc:uncertainty ] ;
    sh:targetClass oc:ObjectEventMixin .

crmdig:D1_Digital_Object a sh:NodeShape ;
    rdfs:comment "A digital object (image, 3D model, scan) that represents a physical object." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:type ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class <http://qudt.org/schema/qudt/Quantity> ] [ sh:class prov:Entity ] ) ;
            sh:path dcterms:relation ],
        [ sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path dcterms:description ],
        [ sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path dcterms:title ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The physical object that a digital representation stands for." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:subject ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:class prov:Activity ;
            sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class prov:Entity ;
            sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:isPartOf ] ;
    sh:targetClass crmdig:D1_Digital_Object .

crmsci:S13_Sample a sh:NodeShape ;
    rdfs:comment "A sample taken from a physical object, for example for an analysis." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class crm:E18_Physical_Thing ;
            sh:description "The object from which a sample was taken." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:sampledFrom ],
        [ sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 11 ;
            sh:path dcterms:description ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:isPartOf ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 10 ;
            sh:path dcterms:title ],
        [ sh:class prov:Activity ;
            sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class prov:Activity ;
            sh:description "The events in the life of an object (production, find, conservation, transfer, move, provenance research, and so on). Range is Activity so that both ObjectEvent subclasses and the DCAT-AP+ data-generating events (MeasurementEvent, DigitisationEvent) can be listed in one biography." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path oc:biography ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oc:uncertainty ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class <http://qudt.org/schema/qudt/Quantity> ] ) ;
            sh:path dcterms:relation ],
        [ sh:class oc:ObjectLocation ;
            sh:description "Where the object is now." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oc:currentLocation ],
        [ sh:class foaf:Agent ;
            sh:description "The agent that currently has custody of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oc:currentKeeper ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Material of a physical object or sample, taken from a controlled vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:material ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if no further findings are to be expected at the site of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oc:noFurtherFindingsExpected ],
        [ sh:description "Handling, presentation, packaging, transport or storage recommendations for the object." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 6 ;
            sh:path oc:recommendation ],
        [ sh:class oc:Dating ;
            sh:description "The dating of an object that has no single production event (for example a monument): absolute period, epoch and whether the absolute dates were derived from the epoch. Use a ProductionEvent where the making is documented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oc:dating ],
        [ sh:class prov:Entity ;
            sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:hasPart ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:type ] ;
    sh:targetClass crmsci:S13_Sample .

oc:ObjectCoreDistribution a sh:NodeShape ;
    rdfs:comment "A distribution that always carries a licence (NFDI Core Metadata Profile, MUST)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dcterms:RightsStatement ;
            sh:description "A statement that specifies rights associated with the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path dcterms:rights ],
        [ sh:description "A free-text account of the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class skos:Concept ;
            sh:description "The status of the distribution in the context of maturity lifecycle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <http://www.w3.org/ns/adms#status> ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:issued ],
        [ sh:description "A name given to the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 23 ;
            sh:path dcterms:title ],
        [ sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
            sh:description "The legislation that mandates the creation or management of the Distribution." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://data.europa.eu/r5r/applicableLegislation> ],
        [ sh:class odrl:Policy ;
            sh:description "The policy expressing the rights associated with the distribution if using the [[ODRL]] vocabulary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path odrl:hasPolicy ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset distribution, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:class dcterms:MediaType ;
            sh:description "The format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcat:compressFormat ],
        [ sh:class rdfs:Resource ;
            sh:description "A URL that gives access to a Distribution of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcat:accessURL ],
        [ sh:class dcterms:LicenseDocument ;
            sh:description "A licence under which the Distribution is made available." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:license ],
        [ sh:class dcterms:MediaType ;
            sh:description "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcat:packageFormat ],
        [ sh:class dcat:DataService ;
            sh:description "A data service that gives access to the distribution of the dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcat:accessService ],
        [ sh:class dcterms:LinguisticSystem ;
            sh:description "A language used in the Distribution." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcterms:language ],
        [ sh:class dcterms:MediaTypeOrExtent ;
            sh:description "The file format of the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:format ],
        [ sh:class foaf:Document ;
            sh:description "A page or document about this Distribution." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path foaf:page ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Distribution was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:modified ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "The size of a Distribution in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcat:byteSize ;
            sh:pattern "([\\-+]?[0-9]+)" ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:class skos:Concept ;
            sh:description "An indication how long it is planned to keep the Distribution of the Dataset available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://data.europa.eu/r5r/availability> ],
        [ sh:class dcterms:MediaType ;
            sh:description "The media type of the Distribution as defined in the official register of media types managed by IANA." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path dcat:mediaType ],
        [ sh:class dcterms:Standard ;
            sh:description "An established schema to which the described Distribution conforms." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:conformsTo ],
        [ sh:class rdfs:Resource ;
            sh:description "A URL that is a direct link to a downloadable file in a given format." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcat:downloadURL ],
        [ sh:class <http://spdx.org/rdf/terms#Checksum> ;
            sh:description "A mechanism that can be used to verify that the contents of a distribution have not changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://spdx.org/rdf/terms#checksum> ] ;
    sh:targetClass oc:ObjectCoreDistribution .

oc:ObjectGeometry a sh:NodeShape ;
    rdfs:comment "A geometry resource (locn:Geometry) with WKT, coordinate reference system and positional accuracy." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype geo:wktLiteral ;
            sh:description "The geometry as well-known text (point, line or polygon, also multi-geometries)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path geo:asWKT ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path dcterms:description ],
        [ sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path dcterms:title ],
        [ sh:class skos:Concept ;
            sh:description "The coordinate reference system of the geometry, as a concept from the EPSG register (for example EPSG:25832). GeoDCAT-AP 3.1.0 defines geodcatap:referenceSystem on datasets, distributions, catalogues and data services; the use on a geometry is an extension." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path geodcatap:referenceSystem ],
        [ sh:description "How exactly the geometry locates the object (for example \"exact\", \"municipality level\"). Free text; use uncertainty for a qualified statement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path oc:positionalAccuracy ] ;
    sh:targetClass oc:ObjectGeometry .

oc:Dating a sh:NodeShape ;
    rdfs:comment "Dating of an object without a single production event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "True if the absolute dates were derived automatically from the epoch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oc:derivedFromEpoch ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oc:uncertainty ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "Earliest and latest date of the dating (ISO 8601-2 / EDTF where the source uses it)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:temporal ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Relative dating as an epoch, taken from a controlled vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:epoch ],
        [ sh:description "Free-text explanation of the uncertainty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path skos:note ] ;
    sh:targetClass oc:Dating .

crm:E18_Physical_Thing a sh:NodeShape ;
    rdfs:comment "The physical object, specimen or monument that datasets and events are about." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type oc:sampledFrom ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcterms:hasPart ],
        [ sh:class oc:ObjectLocation ;
            sh:description "Where the object is now." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oc:currentLocation ],
        [ sh:class oc:Dating ;
            sh:description "The dating of an object that has no single production event (for example a monument): absolute period, epoch and whether the absolute dates were derived from the epoch. Use a ProductionEvent where the making is documented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path oc:dating ],
        [ sh:class prov:Activity ;
            sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:class prov:Activity ;
            sh:description "The events in the life of an object (production, find, conservation, transfer, move, provenance research, and so on). Range is Activity so that both ObjectEvent subclasses and the DCAT-AP+ data-generating events (MeasurementEvent, DigitisationEvent) can be listed in one biography." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path oc:biography ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class <http://qudt.org/schema/qudt/Quantity> ] ) ;
            sh:path dcterms:relation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:type ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Material of a physical object or sample, taken from a controlled vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:material ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if no further findings are to be expected at the site of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path oc:noFurtherFindingsExpected ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oc:uncertainty ],
        [ sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:class foaf:Agent ;
            sh:description "The agent that currently has custody of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oc:currentKeeper ],
        [ sh:description "Handling, presentation, packaging, transport or storage recommendations for the object." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 5 ;
            sh:path oc:recommendation ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:isPartOf ] ;
    sh:targetClass crm:E18_Physical_Thing .

prov:Association a sh:NodeShape ;
    rdfs:comment "An agent together with the role in which it took part in an event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The role in which the agent acted, taken from a controlled vocabulary." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcat:hadRole ],
        [ sh:class foaf:Agent ;
            sh:description "The agent in a participation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path prov:agent ] ;
    sh:targetClass prov:Association .

oc:ObjectLocation a sh:NodeShape ;
    rdfs:comment "A dcterms:Location whose geometry is an ObjectGeometry." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oc:ObjectGeometry ;
            sh:description "The corresponding geometry for a resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path locn:geometry ],
        [ sh:datatype geo:wktLiteral ;
            sh:description "The geographic center (centroid) of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:centroid ],
        [ sh:datatype geo:wktLiteral ;
            sh:description "The geographic bounding box of a resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcat:bbox ] ;
    sh:targetClass oc:ObjectLocation .

oc:Uncertainty a sh:NodeShape ;
    rdfs:comment "A qualified statement of uncertainty about one aspect of an event or object description." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Which aspect of the description is uncertain." ;
            sh:in ( "time_span" "place" "participant" "identification" "event_type" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path oc:aspect ],
        [ sh:description "Free-text explanation of the uncertainty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path skos:note ],
        [ sh:description "Degree of certainty." ;
            sh:in ( "certain" "probable" "possible" "doubtful" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path oc:level ] ;
    sh:targetClass oc:Uncertainty .

