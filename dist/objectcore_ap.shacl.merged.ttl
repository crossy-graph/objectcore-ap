crm:E7_Activity a sh:NodeShape ;
    rdfs:comment "Publication or exhibition of an object (CRM E65 Creation, E7 Activity)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
