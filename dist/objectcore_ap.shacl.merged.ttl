crm:E14_Condition_Assessment a sh:NodeShape ;
    rdfs:comment "Assessing the condition of an object (CRM E14 Condition Assessment)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 12 ;
            sh:path dcterms:description ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:isPartOf ],
        [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:source ],
        [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:qualifiedAssociation ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:hasPart ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Completeness of the object found in a condition assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path oc:completeness ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The condition state found in a condition assessment." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:assessedCondition ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Stability of the object found in a condition assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path oc:stability ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 11 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Degree of damage found in a condition assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:damageDegree ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class schema1:DefinedTerm ] ) ;
            sh:path dcterms:type ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oc:uncertainty ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class <http://qudt.org/schema/qudt/Quantity> ] ) ;
            sh:path dcterms:relation ],
        [ sh:class oc:ObjectLocation ;
            sh:description "The place where an event happened (CRM P7 took place at). Not the spatial coverage of a dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path prov:atLocation ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The period during which an event took place (CRM P4 has time-span)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:temporal ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:used ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:generated ] ;
    sh:targetClass crm:E14_Condition_Assessment .

crm:E5_Event a sh:NodeShape ;
    rdfs:comment "An event in the biography of an object. Concrete subclasses fix the kind of event; the optional type slot refines it with a term from a controlled vocabulary." ;
    sh:closed false ;
    sh:ignoredProperties ( oc:stability oc:hazardType oc:monitoredCondition rdf:type oc:finding oc:transferredFrom oc:treatment oc:protectiveMeasure oc:assessedCondition oc:movedTo oc:transferredTo oc:completeness oc:damageDegree oc:movedFrom ) ;
    sh:property [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
