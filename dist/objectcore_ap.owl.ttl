            owl:onProperty oc:no_further_findings_expected ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:material ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:no_further_findings_expected ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:ObjectLocation ;
            owl:onProperty oc:current_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:material ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:dating ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:no_further_findings_expected ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:Dating ;
            owl:onProperty oc:dating ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:uncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:current_keeper ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:recommendation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:current_keeper ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:recommendation ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
