oc:AgentInRole a owl:Class ;
    rdfs:label "AgentInRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:agent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:agent ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:agent ] ;
    skos:definition "An agent together with the role in which it took part in an event." ;
    skos:exactMatch prov:Association ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ObjectCoreDistribution a owl:Class ;
    rdfs:label "ObjectCoreDistribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/LicenseDocument> ;
            owl:onProperty oc:licence ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/MediaTypeOrExtent> ;
            owl:onProperty oc:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:licence ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:licence ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Distribution> ;
    skos:broadMatch dcat:Distribution ;
    skos:definition "A distribution that always carries a licence (NFDI Core Metadata Profile, MUST)." ;
    skos:exactMatch oc:ObjectCoreDistribution ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ObjectGeometry a owl:Class ;
    rdfs:label "ObjectGeometry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:positional_accuracy ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Concept> ;
            owl:onProperty oc:reference_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:wkt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:wkt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:positional_accuracy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:reference_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:positional_accuracy ],
        [ a owl:Restriction ;
            owl:allValuesFrom geo:wktLiteral ;
            owl:onProperty oc:wkt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:reference_system ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Geometry> ;
    skos:broadMatch locn:Geometry ;
    skos:definition "A geometry resource (locn:Geometry) with WKT, coordinate reference system and positional accuracy." ;
    skos:exactMatch oc:ObjectGeometry ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyAspectEnum#event_type> a owl:Class ;
    rdfs:label "event_type" ;
    rdfs:subClassOf oc:UncertaintyAspectEnum ;
    skos:definition "Interpretation of what kind of event took place." .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyAspectEnum#identification> a owl:Class ;
    rdfs:label "identification" ;
    rdfs:subClassOf oc:UncertaintyAspectEnum ;
    skos:definition "Identification of the object or material." .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyAspectEnum#participant> a owl:Class ;
    rdfs:label "participant" ;
    rdfs:subClassOf oc:UncertaintyAspectEnum ;
    skos:definition "Attribution to an agent or role." .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyAspectEnum#place> a owl:Class ;
    rdfs:label "place" ;
    rdfs:subClassOf oc:UncertaintyAspectEnum ;
    skos:definition "Location of the event or object." .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyAspectEnum#time_span> a owl:Class ;
    rdfs:label "time_span" ;
    rdfs:subClassOf oc:UncertaintyAspectEnum ;
    skos:definition "Dating or duration of the event." .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyLevelEnum#certain> a owl:Class ;
    rdfs:label "certain" ;
    rdfs:subClassOf oc:UncertaintyLevelEnum .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyLevelEnum#doubtful> a owl:Class ;
    rdfs:label "doubtful" ;
    rdfs:subClassOf oc:UncertaintyLevelEnum .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyLevelEnum#possible> a owl:Class ;
    rdfs:label "possible" ;
    rdfs:subClassOf oc:UncertaintyLevelEnum .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyLevelEnum#probable> a owl:Class ;
