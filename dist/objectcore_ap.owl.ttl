    rdfs:label "realized_plan" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Plan> ;
    skos:definition "The slot to specify the Plan (i.e. directive information or procedure) that was realized by an Activity." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/source_metadata> a owl:DatatypeProperty ;
    rdfs:label "source_metadata" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/start_date> a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/status> a owl:DatatypeProperty ;
    rdfs:label "status" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/unit> a owl:ObjectProperty ;
    rdfs:label "unit" ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

oc:Dating a owl:Class ;
    rdfs:label "Dating" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty oc:derived_from_epoch ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:Uncertainty ;
            owl:onProperty oc:uncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:dated_period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:derived_from_epoch ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:epoch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:derived_from_epoch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:dated_period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:uncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:epoch ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/PeriodOfTime> ;
            owl:onProperty oc:dated_period ] ;
    skos:definition "Dating of an object without a single production event." ;
    skos:exactMatch oc:Dating ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ObjectEventMixin a owl:Class ;
    rdfs:label "ObjectEventMixin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Entity> ;
            owl:onProperty oc:evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:event_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:ObjectLocation ;
            owl:onProperty oc:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:participation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:time_span ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:Uncertainty ;
            owl:onProperty oc:uncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:event_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:uncertainty ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:event_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:time_span ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/PeriodOfTime> ;
            owl:onProperty oc:time_span ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:AgentInRole ;
            owl:onProperty oc:participation ] ;
    skos:definition "Slots shared by all events of an object biography." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:agent a owl:ObjectProperty ;
    rdfs:label "agent" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
    skos:definition "The agent in a participation." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:aspect a owl:ObjectProperty ;
    rdfs:label "aspect" ;
    rdfs:range oc:UncertaintyAspectEnum ;
    skos:definition "Which aspect of the description is uncertain." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:completeness a owl:ObjectProperty ;
    rdfs:label "completeness" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Completeness of the object found in a condition assessment." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:current_keeper a owl:ObjectProperty ;
    rdfs:label "current_keeper" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
    skos:definition "The agent that currently has custody of the object." ;
    skos:exactMatch crm:P50_has_current_keeper ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:current_location a owl:ObjectProperty ;
    rdfs:label "current_location" ;
    rdfs:range oc:ObjectLocation ;
    skos:definition "Where the object is now." ;
    skos:exactMatch crm:P55_has_current_location ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:damage_degree a owl:ObjectProperty ;
    rdfs:label "damage_degree" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Degree of damage found in a condition assessment." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:dated_period a owl:ObjectProperty ;
    rdfs:label "dated_period" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/PeriodOfTime> ;
    skos:definition "Earliest and latest date of the dating (ISO 8601-2 / EDTF where the source uses it)." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:dating a owl:ObjectProperty ;
    rdfs:label "dating" ;
    rdfs:range oc:Dating ;
    skos:definition "The dating of an object that has no single production event (for example a monument): absolute period, epoch and whether the absolute dates were derived from the epoch. Use a ProductionEvent where the making is documented." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:derived_from_epoch a owl:DatatypeProperty ;
    rdfs:label "derived_from_epoch" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the absolute dates were derived automatically from the epoch." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:event_type a owl:ObjectProperty ;
    rdfs:label "event_type" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Refines the kind of event with a term from a controlled vocabulary (for example translocation for a move)." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:level a owl:ObjectProperty ;
    rdfs:label "level" ;
    rdfs:range oc:UncertaintyLevelEnum ;
    skos:definition "Degree of certainty." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:moved_from a owl:ObjectProperty ;
    rdfs:label "moved_from" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Location> ;
    skos:definition "The place the object was moved from." ;
    skos:exactMatch crm:P27_moved_from ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:moved_to a owl:ObjectProperty ;
    rdfs:label "moved_to" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Location> ;
    skos:definition "The place the object was moved to." ;
    skos:exactMatch crm:P26_moved_to ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:no_further_findings_expected a owl:DatatypeProperty ;
    rdfs:label "no_further_findings_expected" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if no further findings are to be expected at the site of the object." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:positional_accuracy a owl:DatatypeProperty ;
    rdfs:label "positional_accuracy" ;
    skos:definition "How exactly the geometry locates the object (for example \"exact\", \"municipality level\"). Free text; use uncertainty for a qualified statement." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:reference_system a owl:ObjectProperty ;
    rdfs:label "reference_system" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Concept> ;
    skos:definition "The coordinate reference system of the geometry, as a concept from the EPSG register (for example EPSG:25832). GeoDCAT-AP 3.1.0 defines geodcatap:referenceSystem on datasets, distributions, catalogues and data services; the use on a geometry is an extension." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:represents a owl:ObjectProperty ;
    rdfs:label "represents" ;
    rdfs:range oc:PhysicalObject ;
    skos:closeMatch crm:P138_represents ;
    skos:definition "The physical object that a digital representation stands for." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "The role in which the agent acted, taken from a controlled vocabulary." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:sampled_from a owl:ObjectProperty ;
    rdfs:label "sampled_from" ;
    rdfs:range oc:PhysicalObject ;
    skos:definition "The object from which a sample was taken." ;
    skos:exactMatch crmsci:O5_removed ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:source_system a owl:DatatypeProperty ;
    rdfs:label "source_system" ;
    skos:definition "Name of the system from which the record was exported." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:stability a owl:ObjectProperty ;
    rdfs:label "stability" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Stability of the object found in a condition assessment." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:wkt a owl:DatatypeProperty ;
    rdfs:label "wkt" ;
    rdfs:range geo:wktLiteral ;
    skos:definition "The geometry as well-known text (point, line or polygon, also multi-geometries)." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

geo:wktLiteral a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

<https://w3id.org/nfdi-de/dcat-ap-plus/EvaluatedActivity> a owl:Class ;
    rdfs:label "EvaluatedActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:other_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Identifier> ;
            owl:onProperty oc:other_identifier ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Activity> ;
    skos:definition "An activity or process that is being evaluated in a DataGeneratingActivity." ;
    skos:exactMatch prov:Activity ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

