oc:DigitalRepresentation a owl:Class ;
    rdfs:label "DigitalRepresentation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oc:PhysicalObject ;
            owl:onProperty oc:represents ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:represents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:represents ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/EvaluatedEntity> ;
    skos:definition "A digital object (image, 3D model, scan) that represents a physical object." ;
    skos:exactMatch crmdig:D1_Digital_Object ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:HazardAssessmentEvent a owl:Class ;
    rdfs:label "HazardAssessmentEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:finding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:hazard_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:protective_measure ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:hazard_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:finding ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:protective_measure ],
        oc:ObjectEvent ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Assessing hazards to an object and the protective measures taken (KuR-MDS 4.7)." ;
    skos:exactMatch oc:HazardAssessmentEvent ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:MonitoringEvent a owl:Class ;
    rdfs:label "MonitoringEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:monitored_condition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:monitored_condition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:finding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:finding ],
        oc:ObjectEvent ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Monitoring of conditions around an object, with measured values (KuR-MDS 4.8). Values go into has_quantitative_attribute." ;
    skos:exactMatch oc:MonitoringEvent ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ObjectCoreDataset a owl:Class ;
    rdfs:label "ObjectCoreDataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:source_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:ObjectCoreDistribution ;
            owl:onProperty oc:dataset_distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:is_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:release_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:dataset_distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:release_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:release_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:was_generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/EvaluatedEntity> ;
            owl:onProperty oc:is_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty oc:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DataGeneratingActivity> ;
            owl:onProperty oc:was_generated_by ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Dataset> ;
    skos:broadMatch dcat:Dataset ;
    skos:definition "A dcat:Dataset (DCAT-AP 3.0.1) that describes an object, a sample or events of an object biography. Adds the mandatory elements of the NFDI Core Metadata Profile (identifier, title, creator, resource type, licence via the distribution) on top of DCAT-AP." ;
    skos:exactMatch oc:ObjectCoreDataset ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:Sample a owl:Class ;
