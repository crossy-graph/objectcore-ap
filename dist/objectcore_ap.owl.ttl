        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/unit> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/has_quantity_type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/unit> ],
        [ a owl:Restriction ;
