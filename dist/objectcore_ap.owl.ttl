            owl:minCardinality 0 ;
            owl:onProperty oc:time_span ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Activity>,
        oc:ObjectEventMixin ;
    skos:definition "An event in the biography of an object. Concrete subclasses fix the kind of event; the optional type slot refines it with a term from a controlled vocabulary." ;
    skos:exactMatch crm:E5_Event ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

<http://publications.europa.eu/resource/authority/data-theme> a owl:Class ;
    rdfs:label "DatasetThemes" ;
    rdfs:seeAlso <https://op.europa.eu/s/zXIN> ;
    owl:unionOf ( <http://publications.europa.eu/resource/authority/data-theme/AGRI> <http://publications.europa.eu/resource/authority/data-theme/ECON> <http://publications.europa.eu/resource/authority/data-theme/EDUC> <http://publications.europa.eu/resource/authority/data-theme/ENER> <http://publications.europa.eu/resource/authority/data-theme/ENVI> <http://publications.europa.eu/resource/authority/data-theme/GOVE> <http://publications.europa.eu/resource/authority/data-theme/HEAL> <http://publications.europa.eu/resource/authority/data-theme/INTR> <http://publications.europa.eu/resource/authority/data-theme/JUST> <http://publications.europa.eu/resource/authority/data-theme/OP_DATPRO> <http://publications.europa.eu/resource/authority/data-theme/REGI> <http://publications.europa.eu/resource/authority/data-theme/SOCI> <http://publications.europa.eu/resource/authority/data-theme/TECH> <http://publications.europa.eu/resource/authority/data-theme/TRAN> ) ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> ;
    linkml:permissible_values <http://publications.europa.eu/resource/authority/data-theme/AGRI>,
        <http://publications.europa.eu/resource/authority/data-theme/ECON>,
        <http://publications.europa.eu/resource/authority/data-theme/EDUC>,
        <http://publications.europa.eu/resource/authority/data-theme/ENER>,
        <http://publications.europa.eu/resource/authority/data-theme/ENVI>,
        <http://publications.europa.eu/resource/authority/data-theme/GOVE>,
        <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
        <http://publications.europa.eu/resource/authority/data-theme/INTR>,
        <http://publications.europa.eu/resource/authority/data-theme/JUST>,
        <http://publications.europa.eu/resource/authority/data-theme/OP_DATPRO>,
        <http://publications.europa.eu/resource/authority/data-theme/REGI>,
        <http://publications.europa.eu/resource/authority/data-theme/SOCI>,
        <http://publications.europa.eu/resource/authority/data-theme/TECH>,
        <http://publications.europa.eu/resource/authority/data-theme/TRAN> .

<https://w3id.org/nfdi-de/dcat-ap-plus/modification_date> a owl:DatatypeProperty ;
    rdfs:label "modification_date" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Agent> a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/type> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Concept> ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/type> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/name> ] ;
    skos:definition "See [DCAT-AP specs:Agent](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Agent)" ;
    skos:exactMatch foaf:Agent ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/SupportiveEntity> a owl:Class ;
    rdfs:label "SupportiveEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ] ;
    skos:definition "The supportive entities are supporting the main entities in the Application Profile. They are included in the Application Profile because they form the range of properties." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A slot to provide an URI for an entity within this schema." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> a owl:Class ;
    rdfs:label "DefinedTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/from_CV> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/from_CV> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/from_CV> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/id> ] ;
    skos:definition "A word, name, acronym or phrase that is defined in a controlled vocabulary (CV) and that is used to provide an additional rdf:type or dcterms:type of a class within this schema." ;
    skos:exactMatch schema1:DefinedTerm ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/title> a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "This slot is described in more detail within the class in which it is used." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .


