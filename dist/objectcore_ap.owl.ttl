    skos:exactMatch dcterms:LinguisticSystem ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/QualitativeAttribute> a owl:Class ;
    rdfs:label "QualitativeAttribute" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/value> ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/ClassifierMixin> ;
    skos:definition "A piece of information that is attributed to an Entity, Activity or AgenticEntity." ;
