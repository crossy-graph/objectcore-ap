    rdfs:subClassOf oc:UncertaintyLevelEnum .

<https://w3id.org/nfdi4objects/objectcore-ap/UncertaintyLevelEnum#unknown> a owl:Class ;
    rdfs:label "unknown" ;
    rdfs:subClassOf oc:UncertaintyLevelEnum .

oc:assessed_condition a owl:ObjectProperty ;
    rdfs:label "assessed_condition" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "The condition state found in a condition assessment." ;
    skos:exactMatch crm:E3_Condition_State ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:biography a owl:ObjectProperty ;
    rdfs:label "biography" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/Activity> ;
    skos:closeMatch crm:P12_occurred_in_the_presence_of ;
    skos:definition "The events in the life of an object (production, find, conservation, transfer, move, provenance research, and so on). Range is Activity so that both ObjectEvent subclasses and the DCAT-AP+ data-generating events (MeasurementEvent, DigitisationEvent) can be listed in one biography." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:epoch a owl:ObjectProperty ;
    rdfs:label "epoch" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Relative dating as an epoch, taken from a controlled vocabulary." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:hazard_type a owl:ObjectProperty ;
    rdfs:label "hazard_type" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "The kind of hazard found in a hazard assessment." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:material a owl:ObjectProperty ;
    rdfs:label "material" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Material of a physical object or sample, taken from a controlled vocabulary." ;
    skos:exactMatch crm:P45_consists_of ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:monitored_condition a owl:ObjectProperty ;
    rdfs:label "monitored_condition" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "A condition that is checked in a monitoring event (for example humidity)." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:participation a owl:ObjectProperty ;
    rdfs:label "participation" ;
    rdfs:range oc:AgentInRole ;
    skos:closeMatch crm:P14_carried_out_by ;
    skos:definition "An agent taking part in an event, with the role in which it acted." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:protective_measure a owl:ObjectProperty ;
    rdfs:label "protective_measure" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "A protective measure taken against a hazard." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:recommendation a owl:DatatypeProperty ;
    rdfs:label "recommendation" ;
    skos:definition "Handling, presentation, packaging, transport or storage recommendations for the object." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:treatment a owl:ObjectProperty ;
    rdfs:label "treatment" ;
    rdfs:range <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
    skos:definition "Treatment carried out in a conservation or restoration event." ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

