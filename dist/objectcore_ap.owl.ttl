@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix oc: <https://w3id.org/nfdi4objects/objectcore-ap/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nfdi-de/dcat-ap-plus/AnalysisDataset> a owl:Class ;
    rdfs:label "AnalysisDataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DataAnalysis> ;
            owl:onProperty oc:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:was_generated_by ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/Dataset> ;
    skos:definition "A Dataset that was generated by an analysis of some previously generated data. For example, a dataset that contains the data of an assignment of a chemical structure to a sample based on the spectral data obtained from the sample is an AnalyticalDataset." ;
    skos:exactMatch dcat:Dataset ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi4objects/objectcore-ap.owl.ttl> a owl:Ontology ;
    rdfs:label "objectcore-ap" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "ObjectCore-AP" ;
    pav:version "0.1.0" ;
    rdfs:seeAlso <https://github.com/nfdi-de/dcat-ap-plus>,
        <https://semiceu.github.io/DCAT-AP/> ;
    skos:definition "ObjectCore-AP is an extension of DCAT-AP 3.0.1 (via DCAT-AP+) for the Object Core Metadata Profile (OCMDP) of NFDI4Objects. It adds what DCAT-AP lacks for objects, samples and events in an object biography: typed events (production, find, sampling, measurement, condition assessment, conservation, acquisition, transfer of custody, move, provenance research, digitisation, publication or exhibition) with time span, place, participants in roles, uncertainty and evidence, and a physical object with material, keeper and location. Every instance remains a valid DCAT-AP 3.0.1 dcat:Dataset, so it can be exported unchanged to DCAT-AP consumers. The namespace is provisional until a w3id.org registration exists." .

oc:AcquisitionEvent a owl:Class ;
    rdfs:label "AcquisitionEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:transferred_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:transferred_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:transferred_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:transferred_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:transferred_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:transferred_to ],
        oc:ObjectEvent ;
    skos:definition "Change of ownership (CRM E8 Acquisition)." ;
    skos:exactMatch crm:E8_Acquisition ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ConditionAssessmentEvent a owl:Class ;
    rdfs:label "ConditionAssessmentEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:stability ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:damage_degree ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:completeness ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:assessed_condition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:damage_degree ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:stability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:completeness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:completeness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:damage_degree ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:stability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:assessed_condition ],
        oc:ObjectEvent ;
    skos:definition "Assessing the condition of an object (CRM E14 Condition Assessment)." ;
    skos:exactMatch crm:E14_Condition_Assessment ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ConservationEvent a owl:Class ;
    rdfs:label "ConservationEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DefinedTerm> ;
            owl:onProperty oc:treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:treatment ],
        oc:ObjectEvent ;
    skos:definition "Conservation or restoration treatment (CRM E11 Modification, E87 Curation Activity)." ;
    skos:exactMatch crm:E11_Modification ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:CustodyTransferEvent a owl:Class ;
    rdfs:label "CustodyTransferEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:transferred_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:transferred_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:transferred_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:transferred_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:transferred_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Agent> ;
            owl:onProperty oc:transferred_from ],
        oc:ObjectEvent ;
    skos:definition "Change of custody without change of ownership (CRM E10 Transfer of Custody)." ;
    skos:exactMatch crm:E10_Transfer_of_Custody ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:DigitisationEvent a owl:Class ;
    rdfs:label "DigitisationEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom oc:DigitalRepresentation ;
            owl:onProperty oc:had_output_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:had_output_entity ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/DataGeneratingActivity>,
        oc:ObjectEventMixin ;
    skos:definition "Digitising an object (CRMdig D2 Digitization Process, DCAT-AP+ DataGeneratingActivity)." ;
    skos:exactMatch crmdig:D2_Digitization_Process ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:FindEvent a owl:Class ;
    rdfs:label "FindEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty oc:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty oc:took_place_at ],
        oc:ObjectEvent ;
    skos:definition "Finding or excavating an object (CRMsci S19 Encounter Event, CRMarchaeo A9)." ;
    skos:exactMatch crmsci:S19_Encounter_Event ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:MeasurementEvent a owl:Class ;
    rdfs:label "MeasurementEvent" ;
    rdfs:subClassOf <https://w3id.org/nfdi-de/dcat-ap-plus/DataGeneratingActivity>,
        oc:ObjectEventMixin ;
    skos:definition "Measurement or analysis that produces a dataset (CRMsci S21 Measurement, DCAT-AP+ DataGeneratingActivity)." ;
    skos:exactMatch crmsci:S21_Measurement ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:MoveEvent a owl:Class ;
    rdfs:label "MoveEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:moved_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Location> ;
            owl:onProperty oc:moved_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Location> ;
            owl:onProperty oc:moved_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:moved_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:moved_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty oc:moved_from ],
        oc:ObjectEvent ;
    skos:definition "Change of physical location (CRM E9 Move)." ;
    skos:exactMatch crm:E9_Move ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ProductionEvent a owl:Class ;
    rdfs:label "ProductionEvent" ;
    rdfs:subClassOf oc:ObjectEvent ;
    skos:definition "Making or changing an object (CRM E12 Production, E11 Modification)." ;
    skos:exactMatch crm:E12_Production ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:ProvenanceResearchEvent a owl:Class ;
    rdfs:label "ProvenanceResearchEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty oc:finding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:finding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty oc:evidence ],
        oc:ObjectEvent ;
    skos:definition "Research that establishes or revises provenance statements (CRM E13 Attribute Assignment, CRMinf I15)." ;
    skos:exactMatch crminf:I15_Provenance_Assessment ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:PublicationExhibitionEvent a owl:Class ;
    rdfs:label "PublicationExhibitionEvent" ;
    rdfs:subClassOf oc:ObjectEvent ;
    skos:definition "Publication or exhibition of an object (CRM E65 Creation, E7 Activity)." ;
    skos:exactMatch crm:E7_Activity ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

oc:QUDTQuantityKindEnum a owl:Class ;
    rdfs:label "QUDTQuantityKindEnum" ;
    skos:definition "Possible kinds of quantifiable attribute types provided as QUDT QualityKind instances." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

oc:QUDTUnitEnum a owl:Class ;
    rdfs:label "QUDTUnitEnum" ;
    skos:definition "Possible kinds of QUDT unit instances." ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

oc:SamplingEvent a owl:Class ;
    rdfs:label "SamplingEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:had_output_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom oc:Sample ;
            owl:onProperty oc:had_output_entity ],
        oc:ObjectEvent ;
    skos:definition "Taking a sample from an object (CRMsci S2 Sample Taking)." ;
    skos:exactMatch crmsci:S2_Sample_Taking ;
    skos:inScheme <https://w3id.org/nfdi4objects/objectcore-ap> .

xsd:hexBinary a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "([0-9a-fA-F]{2})*" ] ) ] ) ] .

xsd:nonNegativeInteger a rdfs:Datatype ;
    owl:equivalentClass [ owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "([\\-+]?[0-9]+)" ] ) ] ) ] .

<https://w3id.org/nfdi-de/dcat-ap-plus/AnalysisSourceData> a owl:Class ;
    rdfs:label "AnalysisSourceData" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/DataGeneratingActivity> ;
            owl:onProperty oc:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:was_generated_by ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/EvaluatedEntity> ;
    skos:definition "Information that was evaluated within a DataAnalysis." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Any> a owl:Class ;
    rdfs:label "Any" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ] ;
    skos:definition "This abstract class is needed to create the union of Dataset, DatasetSeries, Catalogue and DataService for the range of the slot [primary_topic](https://nfdi-de.github.io/chem-dcat-ap/elements/primary_topic/)." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Attribution> a owl:Class ;
    rdfs:label "Attribution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/SupportiveEntity> ;
    skos:definition "See [DCAT-AP specs:Attribution](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Attribution)" ;
    skos:exactMatch prov:Attribution ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Checksum> a owl:Class ;
    rdfs:label "Checksum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:hexBinary ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/checksum_value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/ChecksumAlgorithm> ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/algorithm> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/checksum_value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/algorithm> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/checksum_value> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/algorithm> ] ;
    skos:definition "See [DCAT-AP specs:Checksum](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Checksum)" ;
    skos:exactMatch <http://spdx.org/rdf/terms#Checksum> ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/ChecksumAlgorithm> a owl:Class ;
    rdfs:label "ChecksumAlgorithm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/SupportiveEntity> ;
    skos:definition "See [DCAT-AP specs:ChecksumAlgorithm](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ChecksumAlgorithm)" ;
    skos:exactMatch <http://spdx.org/rdf/terms#ChecksumAlgorithm> ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/ConceptScheme> a owl:Class ;
    rdfs:label "ConceptScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/description> ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/SupportiveEntity> ;
    skos:definition "See [DCAT-AP specs:ConceptScheme](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme)" ;
    skos:exactMatch skos:ConceptScheme ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/DataAnalysis> a owl:Class ;
    rdfs:label "DataAnalysis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/AnalysisSourceData> ;
            owl:onProperty oc:evaluated_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:evaluated_entity ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/DataGeneratingActivity> ;
    skos:closeMatch <http://purl.obolibrary.org/obo/NCIT_C25391> ;
    skos:definition "An Activity that evaluates the data produced by another Activity." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/OBI_0200000>,
        prov:Activity ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Device> a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:other_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty oc:has_part ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Identifier> ;
            owl:onProperty oc:other_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/nfdi-de/dcat-ap-plus/Device> ;
            owl:onProperty oc:has_part ],
        <https://w3id.org/nfdi-de/dcat-ap-plus/AgenticEntity> ;
    skos:altLabel "hardware instrument" ;
    skos:definition "A material instrument that is designed to perform a function primarily by means of its mechanical or electrical nature." ;
    skos:exactMatch <http://purl.allotrope.org/ontologies/equipment#AFE_0000354>,
        <http://purl.obolibrary.org/obo/NCIT_C62103>,
        <http://purl.obolibrary.org/obo/OBI_0000968>,
        <http://semanticscience.org/resource/SIO_000956>,
        prov:Agent,
        <https://www.epos-eu.org/epos-dcat-ap#Equipment> ;
    skos:inScheme <https://w3id.org/nfdi-de/dcat-ap-plus> .

<https://w3id.org/nfdi-de/dcat-ap-plus/Policy> a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/nfdi-de/dcat-ap-plus/title> ],
