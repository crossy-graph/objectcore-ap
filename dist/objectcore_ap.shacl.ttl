<http://www.w3.org/2006/vcard/ns#Kind> a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Kind](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Kind)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
