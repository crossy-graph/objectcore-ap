        [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dcterms:source ] ;
    sh:targetClass oc:ObjectEventMixin .

<http://spdx.org/rdf/terms#ChecksumAlgorithm> a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:ChecksumAlgorithm](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ChecksumAlgorithm)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
