@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.cidoc-crm.org/extensions/crmdig/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix geodcatap: <http://data.europa.eu/930/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix oc: <https://w3id.org/nfdi4objects/objectcore-ap/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

crm:E10_Transfer_of_Custody a sh:NodeShape ;
    rdfs:comment "Change of custody without change of ownership (CRM E10 Transfer of Custody)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dcterms:type ],
        [ sh:class oc:ObjectLocation ;
            sh:description "The place where an event happened (CRM P7 took place at). Not the spatial coverage of a dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path prov:atLocation ],
        [ sh:class foaf:Agent ;
            sh:description "The agent that received title or custody." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path oc:transferredTo ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oc:uncertainty ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:used ],
        [ sh:class foaf:Agent ;
            sh:description "The agent that gave up title or custody." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path oc:transferredFrom ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:wasInformedBy ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "The period during which an event took place (CRM P4 has time-span)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dcterms:temporal ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:class <http://qudt.org/schema/qudt/Quantity> ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path dcterms:relation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path rdf:type ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:class prov:Association ;
            sh:description "An agent taking part in an event, with the role in which it acted." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:qualifiedAssociation ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:isPartOf ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:generated ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Refines the kind of event with a term from a controlled vocabulary (for example translocation for a move)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:type ],
        [ sh:class prov:Entity ;
            sh:description "The source or document on which an event statement is based." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:source ] ;
    sh:targetClass crm:E10_Transfer_of_Custody .

crm:E11_Modification a sh:NodeShape ;
