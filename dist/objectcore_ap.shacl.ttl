        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:type ] ;
    sh:targetClass crmdig:D1_Digital_Object .

crmsci:S13_Sample a sh:NodeShape ;
    rdfs:comment "A sample taken from a physical object, for example for an analysis." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:relation ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A slot to provide a secondary identifier of the EvaluatedEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class prov:Activity ;
            sh:description "A slot to provide the Activity which created the EvaluatedEntity." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a description for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "The slot to provide a title for the EvaluatedEntity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:title ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dcterms:isPartOf ],
        [ sh:class crm:E18_Physical_Thing ;
            sh:description "The object from which a sample was taken." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path oc:sampledFrom ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if no further findings are to be expected at the site of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path oc:noFurtherFindingsExpected ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:type ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path rdf:type ],
        [ sh:class prov:Activity ;
            sh:description "The events in the life of an object (production, find, conservation, transfer, move, provenance research, and so on). Range is Activity so that both ObjectEvent subclasses and the DCAT-AP+ data-generating events (MeasurementEvent, DigitisationEvent) can be listed in one biography." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path oc:biography ],
        [ sh:class prov:Entity ;
            sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dcterms:hasPart ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Material of a physical object or sample, taken from a controlled vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:material ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path oc:uncertainty ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ],
        [ sh:class foaf:Agent ;
            sh:description "The agent that currently has custody of the object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oc:currentKeeper ],
        [ sh:class oc:ObjectLocation ;
            sh:description "Where the object is now." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path oc:currentLocation ],
        [ sh:class oc:Dating ;
            sh:description "The dating of an object that has no single production event (for example a monument): absolute period, epoch and whether the absolute dates were derived from the epoch. Use a ProductionEvent where the making is documented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path oc:dating ],
        [ sh:datatype xsd:string ;
            sh:description "Handling, presentation, packaging, transport or storage recommendations for the object." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path oc:recommendation ],
        [ sh:class <http://qudt.org/schema/qudt/Quantity> ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path dcterms:relation ] ;
    sh:targetClass crmsci:S13_Sample .

skos:ConceptScheme a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:ConceptScheme](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name of the concept scheme." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass skos:ConceptScheme .

dcat:Role a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Role](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Role)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass dcat:Role .

locn:Geometry a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Geometry](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Geometry)" ;
    sh:closed false ;
    sh:ignoredProperties ( oc:positionalAccuracy rdf:type geodcatap:referenceSystem geo:asWKT ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass locn:Geometry .

prov:SoftwareAgent a sh:NodeShape ;
    rdfs:comment "An instrument composed of a series of instructions that can be interpreted by or directly executed by a computer." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <http://qudt.org/schema/qudt/Quantity> ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Agent ;
            sh:description "The slot to provide the AgenticEntity of which theAgenticEntity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "A slot to provide a secondary identifier for a Software." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:relation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class prov:SoftwareAgent ;
            sh:description "The slot to specify parts of a Software that are themselves Software." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/nfdi-de/dcat-ap-plus/id> ] ;
    sh:targetClass prov:SoftwareAgent .

oc:ObjectCoreDistribution a sh:NodeShape ;
    rdfs:comment "A distribution that always carries a licence (NFDI Core Metadata Profile, MUST)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dcterms:MediaType ;
            sh:description "The format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dcat:compressFormat ],
        [ sh:class skos:Concept ;
            sh:description "An indication how long it is planned to keep the Distribution of the Dataset available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <http://data.europa.eu/r5r/availability> ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Distribution was changed or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:modified ],
        [ sh:class dcterms:MediaType ;
            sh:description "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcat:packageFormat ],
        [ sh:class dcterms:MediaType ;
            sh:description "The media type of the Distribution as defined in the official register of media types managed by IANA." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path dcat:mediaType ],
        [ sh:class dcterms:RightsStatement ;
            sh:description "A statement that specifies rights associated with the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path dcterms:rights ],
        [ sh:class dcterms:LinguisticSystem ;
            sh:description "A language used in the Distribution." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path dcterms:language ],
        [ sh:datatype xsd:date ;
            sh:description "The date of formal issuance (e.g., publication) of the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dcterms:issued ],
        [ sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
            sh:description "The legislation that mandates the creation or management of the Distribution." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://data.europa.eu/r5r/applicableLegislation> ],
        [ sh:datatype xsd:duration ;
            sh:description "The minimum time period resolvable in the dataset distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcat:temporalResolution ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:datatype xsd:decimal ;
            sh:description "The minimum spatial separation resolvable in a dataset distribution, measured in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcat:spatialResolutionInMeters ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "The size of a Distribution in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcat:byteSize ;
            sh:pattern "([\\-+]?[0-9]+)" ],
        [ sh:class dcterms:Standard ;
            sh:description "An established schema to which the described Distribution conforms." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path dcterms:conformsTo ],
        [ sh:class dcat:DataService ;
            sh:description "A data service that gives access to the distribution of the dataset." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcat:accessService ],
        [ sh:class rdfs:Resource ;
            sh:description "A URL that is a direct link to a downloadable file in a given format." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcat:downloadURL ],
        [ sh:class dcterms:LicenseDocument ;
            sh:description "A licence under which the Distribution is made available." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:license ],
        [ sh:class odrl:Policy ;
            sh:description "The policy expressing the rights associated with the distribution if using the [[ODRL]] vocabulary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path odrl:hasPolicy ],
        [ sh:class rdfs:Resource ;
            sh:description "A URL that gives access to a Distribution of the Dataset." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcat:accessURL ],
        [ sh:class dcterms:MediaTypeOrExtent ;
            sh:description "The file format of the Distribution." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:format ],
        [ sh:class skos:Concept ;
            sh:description "The status of the distribution in the context of maturity lifecycle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <http://www.w3.org/ns/adms#status> ],
        [ sh:class <http://spdx.org/rdf/terms#Checksum> ;
            sh:description "A mechanism that can be used to verify that the contents of a distribution have not changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <http://spdx.org/rdf/terms#checksum> ],
        [ sh:class foaf:Document ;
            sh:description "A page or document about this Distribution." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path foaf:page ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "A name given to the Distribution." ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:title ] ;
    sh:targetClass oc:ObjectCoreDistribution .

oc:ObjectGeometry a sh:NodeShape ;
    rdfs:comment "A geometry resource (locn:Geometry) with WKT, coordinate reference system and positional accuracy." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype geo:wktLiteral ;
            sh:description "The geometry as well-known text (point, line or polygon, also multi-geometries)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path geo:asWKT ],
        [ sh:class skos:Concept ;
            sh:description "The coordinate reference system of the geometry, as a concept from the EPSG register (for example EPSG:25832). GeoDCAT-AP 3.1.0 defines geodcatap:referenceSystem on datasets, distributions, catalogues and data services; the use on a geometry is an extension." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path geodcatap:referenceSystem ],
        [ sh:datatype xsd:string ;
            sh:description "How exactly the geometry locates the object (for example \"exact\", \"municipality level\"). Free text; use uncertainty for a qualified statement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oc:positionalAccuracy ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:description ] ;
    sh:targetClass oc:ObjectGeometry .

<http://spdx.org/rdf/terms#Checksum> a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Checksum](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Checksum)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:hexBinary ;
            sh:description "A lower case hexadecimal encoded digest value produced using a specific algorithm." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://spdx.org/rdf/terms#checksumValue> ;
            sh:pattern "([0-9a-fA-F]{2})*" ],
        [ sh:class <http://spdx.org/rdf/terms#ChecksumAlgorithm> ;
            sh:description "The algorithm used to produce the subject Checksum." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://spdx.org/rdf/terms#algorithm> ] ;
    sh:targetClass <http://spdx.org/rdf/terms#Checksum> .

time:Instant a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:TimeInstant](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#TimeInstant)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass time:Instant .

dcat:CatalogRecord a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:CatalogueRecord](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A name given to the Catalogue Record." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:date ;
            sh:description "The date on which the description of the Resource was included in the Catalogue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:issued ],
        [ sh:datatype xsd:string ;
            sh:description "A free-text account of the record. This property can be repeated for parallel language versions of the description." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class dcat:CatalogRecord ;
            sh:description "The original metadata that was used in creating metadata for the Dataset, Data Service or Dataset Series." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dcterms:source ],
        [ sh:class dcterms:LinguisticSystem ;
            sh:description "A language used in the textual metadata describing titles, descriptions, etc. of the Catalogued Resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:language ],
        [ sh:datatype xsd:date ;
            sh:description "The most recent date on which the Catalogue entry was changed or modified." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:modified ],
        [ sh:class skos:Concept ;
            sh:description "The status of the catalogue record in the context of editorial flow of the dataset and data service descriptions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <http://www.w3.org/ns/adms#status> ],
        [ sh:class dcterms:Standard ;
            sh:description "An Application Profile that the Catalogued Resource&#39;s metadata conforms to." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:conformsTo ],
        [ sh:description "A link to the Dataset, Data service or Catalog described in the record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class dcat:Catalog ] [ sh:class dcat:Dataset ] [ sh:class dcat:DatasetSeries ] [ sh:class dcat:DataService ] ) ;
            sh:order 6 ;
            sh:path foaf:primaryTopic ] ;
    sh:targetClass dcat:CatalogRecord .

odrl:Policy a sh:NodeShape ;
    rdfs:comment "See [DCAT-AP specs:Policy](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Policy)" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass odrl:Policy .

oc:Dating a sh:NodeShape ;
    rdfs:comment "Dating of an object without a single production event." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path oc:uncertainty ],
        [ sh:class dcterms:PeriodOfTime ;
            sh:description "Earliest and latest date of the dating (ISO 8601-2 / EDTF where the source uses it)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:temporal ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "Relative dating as an epoch, taken from a controlled vocabulary." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path oc:epoch ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the absolute dates were derived automatically from the epoch." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path oc:derivedFromEpoch ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text explanation of the uncertainty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:note ] ;
    sh:targetClass oc:Dating .

dcterms:MediaTypeOrExtent a sh:NodeShape ;
