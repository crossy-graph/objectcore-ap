            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path prov:atLocation ],
        [ sh:class oc:Uncertainty ;
            sh:description "A statement about how certain or vague an aspect of the event or object description is." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path oc:uncertainty ],
        [ sh:class <http://www.w3.org/ns/adms#Identifier> ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <http://www.w3.org/ns/adms#identifier> ],
        [ sh:class prov:Association ;
